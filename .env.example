# Public site URL (used for Open Graph absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Spotify Developer App — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# From: npm run spotify:auth  (required only for --create-playlists)
SPOTIFY_REFRESH_TOKEN=

# Apple Music MusicKit — https://developer.apple.com/documentation/applemusicapi
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# PEM contents; use \n for newlines if single-lined
APPLE_MUSIC_PRIVATE_KEY=
# Music User Token from MusicKit JS authorize() — for creating library playlists
APPLE_MUSIC_USER_TOKEN=
